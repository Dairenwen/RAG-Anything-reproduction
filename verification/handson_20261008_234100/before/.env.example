# Copy to .env and fill locally. Do not paste keys into the chat.
TEXT_API_KEY=
TEXT_BASE_URL=https://api.openai.com/v1
TEXT_MODEL=gpt-4o-mini

# Blank key / base URL falls back to TEXT_API_KEY / TEXT_BASE_URL.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=gpt-4o-mini
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
# Disable for providers that do not support the dimensions parameter.
EMBEDDING_SEND_DIMENSIONS=true

# Conservative pilot settings, not the paper's exact experimental settings.
CHUNK_SIZE=1200
CHUNK_OVERLAP=100
TOP_K=20
CHUNK_TOP_K=10
MAX_ENTITY_TOKENS=4000
MAX_RELATION_TOKENS=4000
MAX_TOTAL_TOKENS=12000
LLM_CONCURRENCY=2
SUMMARY_LANGUAGE=English


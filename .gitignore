# Keep secrets and machine-specific environments local.
.env
.env.*
!.env.example

.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Editor, macOS, and temporary cache files.
.idea/
.vscode/
.DS_Store
._*
*.swp
*.swo
*~

# Exclude large model weights, while retaining model configuration/tokenizers.
/models/**/*.safetensors
/models/**/*.bin
/models/**/*.pt
/models/**/*.pth
/models/**/*.ckpt
/models/**/*.onnx

# Papers, parsed resources, knowledge bases, query runs, and verification records
# are intentionally versioned so Markdown links remain usable after cloning.

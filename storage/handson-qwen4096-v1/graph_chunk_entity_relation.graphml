  <data key="d2">Docbench is a paper about a benchmark for evaluating llm-based document reading systems.</data>
  <data key="d3">chunk-76a69463e145e164e890b6c29aba9ec0</data>
  <data key="d4">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>
  <data key="d5">1791514176</data>
  <data key="d6"></data>
</node>
<node id="Rag-Anything">
  <data key="d0">Rag-Anything</data>
  <data key="d1">method</data>
  <data key="d2">RAG-Anything is a system with structure-aware capabilities for multimodal content understanding tasks, demonstrated through case studies involving visual reasoning and chart interpretation.</data>
  <data key="d3">chunk-76a69463e145e164e890b6c29aba9ec0</data>
  <data key="d4">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>
  <data key="d5">1791514176</data>
  <data key="d6"></data>
</node>
<node id="Docbench Benchmark">
  <data key="d0">Docbench Benchmark</data>
  <data key="d1">data</data>
  <data key="d2">DocBench is a benchmark encompassing medium- to long-length documents across various domains including legal, governmental, and financial files, with financial reports averaging 192 pages and news consisting of single-page newspapers.</data>
  <data key="d3">chunk-76a69463e145e164e890b6c29aba9ec0</data>
  <data key="d4">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>
  <data key="d5">1791514176</data>
  <data key="d6"></data>
</node>
<node id="Mmlongbench Benchmark">
  <data key="d0">Mmlongbench Benchmark</data>
  <data key="d1">data</data>
  <data key="d2">MMLongBench is a benchmark demonstrating a broad spectrum of document types and lengths, including research reports, tutorials, academic papers of 35-58 pages, guidebooks of approximately 78 pages, and financial reports as the longest category.</data>
  <data key="d3">chunk-76a69463e145e164e890b6c29aba9ec0</data>
  <data key="d4">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>
  <data key="d5">1791514176</data>
  <data key="d6"></data>
</node>

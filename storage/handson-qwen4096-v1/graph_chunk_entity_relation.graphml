<edge source="Multimodal Knowledge Unification" target="atomic content units">
  <data key="d7">1.0</data>
  <data key="d8">Multimodal Knowledge Unification decomposes raw inputs into atomic content units that preserve structural context and semantic alignment.</data>
  <data key="d9">content extraction,representation</data>
  <data key="d10">chunk-dded67fd8182de2201aa35ccbb4c8cd9</data>
  <data key="d11">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>

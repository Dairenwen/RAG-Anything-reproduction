</node>
<node id="DAE">
  <data key="d0">DAE</data>
  <data key="d1">method</data>
  <data key="d2">DAE (Deterministic Autoencoder) is a model whose style space shows a clearer separation between different styles according to Figure 2.</data>
  <data key="d3">chunk-a3ef854a849174a61602e3f9d4a8eac1</data>
  <data key="d4">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>

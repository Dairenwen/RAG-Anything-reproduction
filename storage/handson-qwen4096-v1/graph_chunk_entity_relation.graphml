<node id="Knowledge Representation">
  <data key="d0">Knowledge Representation</data>
  <data key="d1">concept</data>
  <data key="d2">Knowledge Representation is a field that deals with the formalization and structuring of knowledge.</data>
  <data key="d3">chunk-abcce11b032cb7a3594b3a1302046124</data>
  <data key="d4">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>

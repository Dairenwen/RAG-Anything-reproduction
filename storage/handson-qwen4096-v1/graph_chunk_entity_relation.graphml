</node>
<node id="Twitter15">
  <data key="d0">Twitter15</data>
  <data key="d1">data</data>
  <data key="d2">Twitter15 is a dataset used to evaluate accuracy of GCAN submodel component removal.&lt;SEP&gt;Twitter15 is a dataset used to evaluate the accuracy of GCAN sub-model configurations.&lt;SEP&gt;Twitter15 is a dataset used to evaluate the accuracy of GCAN submodel component removal.</data>
  <data key="d3">chunk-7aefd567d430c404aab77872282400eb&lt;SEP&gt;chunk-306f65a0f4295fa49788ecf8659d4b81&lt;SEP&gt;chunk-89ff37f1683bc8edc5276effd3646dee</data>
  <data key="d4">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>

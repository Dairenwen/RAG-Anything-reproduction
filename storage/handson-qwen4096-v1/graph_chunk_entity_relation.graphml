</node>
<node id="Textual Context">
  <data key="d0">Textual Context</data>
  <data key="d1">data</data>
  <data key="d2">Textual context is a structured representation constructed by concatenating entity summaries, relationship descriptions, and chunk contents with delimiters indicating modality types and hierarchical origins.</data>
  <data key="d3">chunk-2d4727f37ea1b30518f13dc89ffc7ea1</data>
  <data key="d4">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>

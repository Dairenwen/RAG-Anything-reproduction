  <data key="d0">Zirui Guo</data>
  <data key="d1">person</data>
  <data key="d2">Zirui Guo is an author of the RAG-Anything paper affiliated with The University of Hong Kong.&lt;SEP&gt;Zirui Guo is an author of the LightRAG work.</data>
  <data key="d3">chunk-a43d425aea6f4b6c0edc38f28595f400&lt;SEP&gt;chunk-f5f0a5a74b5a4eac43772c74649ca651</data>

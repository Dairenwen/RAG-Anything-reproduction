  <data key="d6"></data>
</node>
<node id="Modality-Aware Graphs">
  <data key="d0">Modality-Aware Graphs</data>
  <data key="d1">concept</data>
  <data key="d2">Modality-aware graphs are built by RAG-Anything to preserve essential relationships such as table header-cell-unit edges and panel-caption-axis edges.</data>
  <data key="d3">chunk-de93d4b6f02e5ae737b9b9e8142401cd</data>

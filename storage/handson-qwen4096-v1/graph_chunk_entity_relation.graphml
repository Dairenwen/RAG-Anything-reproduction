  <data key="d13"></data>
</edge>
<edge source="Unified Knowledge Graph" target="Structural Knowledge Navigation">
  <data key="d7">1.0</data>
  <data key="d8">Structural Knowledge Navigation exploits the structural properties encoded within the Unified Knowledge Graph.</data>
  <data key="d9">graph exploitation,structural properties</data>
  <data key="d10">chunk-ea106f7be2831088c0a1118ecb40eee8</data>
  <data key="d11">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>

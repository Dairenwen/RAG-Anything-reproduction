  <data key="d2">Image details is a section in the prompt listing image path, captions, and footnotes as bullet points.</data>
  <data key="d3">chunk-840e794a234c66ff0680c138d02d19ef</data>
  <data key="d4">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>
  <data key="d5">1791514430</data>
  <data key="d6"></data>

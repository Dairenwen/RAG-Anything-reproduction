  <data key="d13"></data>
</edge>
<edge source="Multimodal Knowledge Unification" target="text">
  <data key="d7">1.0</data>
  <data key="d8">Multimodal Knowledge Unification ensures that text is segmented into coherent paragraphs or list items.</data>

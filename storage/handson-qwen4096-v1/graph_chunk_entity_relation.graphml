  <data key="d6"></data>
</node>
<node id="Intra-Modal Structures">
  <data key="d0">Intra-Modal Structures</data>
  <data key="d1">concept</data>
  <data key="d2">Intra-modal structures are rich structural information within each modality of multimodal documents, crucial for accurate reasoning.</data>
  <data key="d3">chunk-de93d4b6f02e5ae737b9b9e8142401cd</data>

  <data key="d1">artifact</data>
  <data key="d2">The Equation Analysis Prompt File is a file named 'equation_analysis_prompt.png' displayed in a code editor window with a light gray background and a title bar showing three colored dots.</data>
  <data key="d3">chunk-9d556fb722f8eac5fc92376e70d34e60</data>
  <data key="d4">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>
  <data key="d5">1791514434</data>
  <data key="d6"></data>
</node>
<node id="Equation Information">
  <data key="d0">Equation Information</data>
  <data key="d1">data</data>
  <data key="d2">Equation Information is a placeholder within the equation analysis prompt that includes the 'Equation' and 'Format' fields.</data>
  <data key="d3">chunk-9d556fb722f8eac5fc92376e70d34e60</data>
  <data key="d4">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>

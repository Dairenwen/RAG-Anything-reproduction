<node id="Xubin Ren">
  <data key="d0">Xubin Ren</data>
  <data key="d1">person</data>
  <data key="d2">Xubin Ren is an author of the RAG-Anything paper affiliated with The University of Hong Kong.&lt;SEP&gt;Xubin Ren is a co-author of the paper "Videorag: Retrieval-augmented generation with extreme long-context videos."</data>
  <data key="d3">chunk-a43d425aea6f4b6c0edc38f28595f400&lt;SEP&gt;chunk-76a69463e145e164e890b6c29aba9ec0</data>

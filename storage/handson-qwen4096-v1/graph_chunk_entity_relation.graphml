  <data key="d0">Research</data>
  <data key="d1">concept</data>
  <data key="d2">Research documents are categorized as a type of document in the MMLongBench benchmark.</data>
  <data key="d3">chunk-6489e2fb8e8849e9fba34fe5f95e4a0f</data>

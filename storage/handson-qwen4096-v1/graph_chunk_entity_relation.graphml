  <data key="d0">Novo Nordisk</data>
  <data key="d1">organization</data>
  <data key="d2">Novo Nordisk is a company whose financial report is used in the financial table navigation case study.</data>
  <data key="d3">chunk-17a576920c675eca791231767d46477b</data>

  <data key="d6"></data>
</node>
<node id="JSON Response Schema">
  <data key="d0">JSON Response Schema</data>
  <data key="d1">data</data>
  <data key="d2">The JSON response schema is a structured format within the equation analysis prompt that includes a 'detailed_description' field with bullet points for analysis aspects and an 'entity_info' object with 'entity_name', 'entity_type', and 'summary' fields.</data>
  <data key="d3">chunk-9d556fb722f8eac5fc92376e70d34e60</data>
  <data key="d4">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>

<node id="GNN-RAG">
  <data key="d0">GNN-RAG</data>
  <data key="d1">method</data>
  <data key="d2">GNN-RAG is a neural graph construction model for retrieval-augmented generation.</data>
  <data key="d3">chunk-f5f0a5a74b5a4eac43772c74649ca651</data>

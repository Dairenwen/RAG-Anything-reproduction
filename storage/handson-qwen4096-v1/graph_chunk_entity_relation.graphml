</edge>
<edge source="Unified Knowledge Graph" target="Embedding Function">
  <data key="d7">1.0</data>
  <data key="d8">The Embedding Function is tailored for each component type to generate embeddings used within the Unified Knowledge Graph.</data>
  <data key="d9">component representation,embedding generation</data>
  <data key="d10">chunk-ea106f7be2831088c0a1118ecb40eee8</data>
  <data key="d11">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>

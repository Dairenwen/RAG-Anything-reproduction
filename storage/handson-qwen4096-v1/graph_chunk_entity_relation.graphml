  <data key="d6"></data>
</node>
<node id="HippoRAG">
  <data key="d0">HippoRAG</data>
  <data key="d1">method</data>
  <data key="d2">HippoRAG is a memory-augmented variant of graph-based retrieval-augmented generation inspired by neurobiology.</data>
  <data key="d3">chunk-f5f0a5a74b5a4eac43772c74649ca651</data>
  <data key="d4">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>
  <data key="d5">1791514177</data>
  <data key="d6"></data>
</node>
<node id="RAPTOR">
  <data key="d0">RAPTOR</data>
  <data key="d1">method</data>
  <data key="d2">RAPTOR is a hierarchical knowledge aggregation method for multi-level reasoning.</data>
  <data key="d3">chunk-f5f0a5a74b5a4eac43772c74649ca651</data>
  <data key="d4">/Users/drw/PycharmProjects/rag-anything-reproduction/data/RAG-Anything_arXiv_2025.pdf</data>
  <data key="d5">1791514177</data>
  <data key="d6"></data>
</node>

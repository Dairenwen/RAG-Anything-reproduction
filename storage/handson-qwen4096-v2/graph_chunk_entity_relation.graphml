<node id="Image File">
  <data key="d0">Image File</data>
  <data key="d1">artifact</data>
  <data key="d2">An Image File is a packaged file created from downloaded plugins, used to transfer and deploy MCP services onto offline servers.</data>
  <data key="d3">chunk-46e12b3f95e745beb9427a8d2c356fd6</data>
  <data key="d4">/Users/drw/PycharmProjects/RAG-Anything-reproduction/data/MCP服务.pdf</data>

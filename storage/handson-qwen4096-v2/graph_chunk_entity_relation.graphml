  <data key="d0">Enter Checkout</data>
  <data key="d1">concept</data>
  <data key="d2">Enter Checkout is a stage in the user purchase journey where users proceed to checkout, receiving flow from adding to cart and splitting into completing payment or abandoning checkout.</data>
  <data key="d3">chunk-3da2e3ba09aaf5c26f390a62fa29f730</data>
  <data key="d4">/Users/drw/PycharmProjects/RAG-Anything-reproduction/data/MCP服务.pdf</data>

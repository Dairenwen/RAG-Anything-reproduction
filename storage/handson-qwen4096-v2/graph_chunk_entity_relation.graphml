  <data key="d6"></data>
</node>
<node id="Shanghai">
  <data key="d0">Shanghai</data>
  <data key="d1">location</data>
  <data key="d2">Shanghai is a city included in the preset weather data of the weather tool, with a temperature of 28 and cloudy conditions.&lt;SEP&gt;Shanghai is a city with preset weather data in the weather tool, showing temperature 28 and cloudy condition.&lt;SEP&gt;Shanghai is a city with weather data showing a temperature of 28 degrees and cloudy conditions.&lt;SEP&gt;Shanghai is a city whose weather query returns a temperature of 28 degrees Celsius and cloudy conditions.&lt;SEP&gt;Shanghai is a city in the preset weather data with temperature 28°C and condition多云, and was invoked in a tool call during testing.&lt;SEP&gt;Shanghai is a city included in the preset weather data with a temperature of 28 and a condition of "多云".</data>
  <data key="d3">chunk-ac52de499112f50a44504163e36d0194&lt;SEP&gt;chunk-028b6088d3cdecf0364e7e5da0b83b66&lt;SEP&gt;chunk-f36f33d14dcadc9d9f0360473719433d&lt;SEP&gt;chunk-886c2e8ce4df58fde41127defb87413b&lt;SEP&gt;chunk-677387b0d12710d9b55ebc13fd550e1e&lt;SEP&gt;chunk-d14809c97d977d90b6981933292df49d</data>

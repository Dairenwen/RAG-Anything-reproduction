<node id="Sankey Chart">
  <data key="d0">Sankey Chart</data>
  <data key="d1">content</data>
  <data key="d2">The Sankey Chart is a generated visualization titled "用户购买旅程桑基图" that depicts a user purchase journey with flows such as visiting a website, browsing products, adding to cart, and completing payment.</data>
  <data key="d3">chunk-9208d3d4d0af3445436567fdc54112d7</data>
  <data key="d4">/Users/drw/PycharmProjects/RAG-Anything-reproduction/data/MCP服务.pdf</data>
  <data key="d5">1791615472</data>
  <data key="d6"></data>
</node>
<node id="User Purchase Journey">
  <data key="d0">User Purchase Journey</data>
  <data key="d1">concept</data>
  <data key="d2">The User Purchase Journey is a conceptual flow represented in the Sankey chart, illustrating stages from visiting a website through browsing products, adding to cart, proceeding to checkout, and either completing or abandoning payment.</data>
  <data key="d3">chunk-9208d3d4d0af3445436567fdc54112d7</data>
  <data key="d4">/Users/drw/PycharmProjects/RAG-Anything-reproduction/data/MCP服务.pdf</data>

  <data key="d6"></data>
</node>
<node id="Plugin">
  <data key="d0">Plugin</data>
  <data key="d1">artifact</data>
  <data key="d2">A Plugin is a component that needs to be downloaded on a networked machine before being packaged into an image file for offline deployment.</data>
  <data key="d3">chunk-46e12b3f95e745beb9427a8d2c356fd6</data>
  <data key="d4">/Users/drw/PycharmProjects/RAG-Anything-reproduction/data/MCP服务.pdf</data>

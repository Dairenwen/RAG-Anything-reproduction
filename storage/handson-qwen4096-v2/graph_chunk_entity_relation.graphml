<node id="WenQuanYi Zen Hei">
  <data key="d0">WenQuanYi Zen Hei</data>
  <data key="d1">artifact</data>
  <data key="d2">WenQuanYi Zen Hei is a font family used in the theme configuration of the sankey diagram test case.&lt;SEP&gt;WenQuanYi Zen Hei is the font family used in the Sankey diagram theme.&lt;SEP&gt;WenQuanYi Zen Hei is the font family used for the text labels in the Sankey diagram.</data>
  <data key="d3">chunk-7dfd9edaf2d6d316a2d66cb563a7b6fd&lt;SEP&gt;chunk-028b6088d3cdecf0364e7e5da0b83b66&lt;SEP&gt;chunk-3da2e3ba09aaf5c26f390a62fa29f730</data>

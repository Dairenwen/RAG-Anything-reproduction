  <data key="d0">Complete Payment</data>
  <data key="d1">concept</data>
  <data key="d2">Complete Payment is the final successful stage in the user purchase journey, receiving flow from entering checkout.</data>
  <data key="d3">chunk-3da2e3ba09aaf5c26f390a62fa29f730</data>
  <data key="d4">/Users/drw/PycharmProjects/RAG-Anything-reproduction/data/MCP服务.pdf</data>

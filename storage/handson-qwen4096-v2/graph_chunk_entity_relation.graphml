<node id="One-Click Installation">
  <data key="d0">One-Click Installation</data>
  <data key="d1">method</data>
  <data key="d2">One-click installation is a feature of MCPHub that simplifies environment setup by automatically installing and configuring MCP servers.</data>
  <data key="d3">chunk-7dfd9edaf2d6d316a2d66cb563a7b6fd</data>
  <data key="d4">/Users/drw/PycharmProjects/RAG-Anything-reproduction/data/MCP服务.pdf</data>
